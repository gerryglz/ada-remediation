{
  "name": "ada-remediation",
  "version": "0.1.0",
  "private": true,
  "description": "Accessibility auditing and conservative remediation CLI for websites and source repositories.",
  "homepage": "https://github.com/gerryglz/ada-remediation#readme",
  "bugs": {
    "url": "https://github.com/gerryglz/ada-remediation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerryglz/ada-remediation.git"
  },
  "type": "module",
  "bin": {
    "ada-assistant": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "ui": "npm run build && node dist/cli.js ui",
    "ui:stop": "npm run build && node dist/cli.js ui stop",
    "test": "vitest run",
    "test:a11y": "vitest run --config vitest.e2e.config.ts tests/e2e/dashboard-accessibility.test.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "release:check": "npm run check && npm pack --dry-run"
  },
  "keywords": [
    "accessibility",
    "wcag",
    "ada",
    "axe-core",
    "a11y"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axe-core": "^4.10.3",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "parse5": "^7.3.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
